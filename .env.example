APP_PASSWORD=change-this-shared-password
APP_SECRET=change-this-random-secret-at-least-32-chars
PUBLIC_ORIGIN=https://download.yourdomain.com
DOWNLOAD_DIR=./downloads
SQLITE_PATH=./data/app.db
MAX_DURATION_SECONDS=7200
MAX_ACTIVE_JOBS=1
MAX_QUEUED_JOBS=25
MAX_TEMP_GB=20
FILE_TTL_SECONDS=3600
CLEANUP_INTERVAL_SECONDS=900
CLOUDFLARED_TOKEN=
# Optional: path to a Netscape-format cookies.txt on the host
# Export from browser with e.g. the "Get cookies.txt LOCALLY" extension
# YTDLP_COOKIES_PATH=/path/to/cookies.txt
