# The local port used by the native launcher.
APP_PORT=8080

# The address used by the native launcher. Keep the loopback default unless
# access is protected by a VPN, firewall, or authenticated reverse proxy.
APP_BIND_HOST=127.0.0.1

# Download service limits. Raise these only if the host and network can support it.
MAX_ACTIVE_JOBS=2
MAX_QUEUED_JOBS=20
MAX_DURATION_SECONDS=7200
CACHE_LIMIT_GB=20
CLEANUP_INTERVAL_SECONDS=900

# Public installations should keep the default request limits or place the app
# behind a reverse proxy / network access control.
ANALYZE_REQUESTS_PER_MINUTE=8
JOB_REQUESTS_PER_HOUR=12

# Optional. Provide a Netscape cookies.txt file for sources that require it.
# Keep the file outside this repository.
# YTDLP_COOKIES_FILE=/absolute/path/to/cookies.txt
